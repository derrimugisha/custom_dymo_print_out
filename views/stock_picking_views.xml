<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add "Send" button to the standard stock.picking form view -->
    <record id="view_picking_form_send_button" model="ir.ui.view">
        <field name="name">stock.picking.form.send.button</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_validate']" position="before">
                <button name="action_send" type="object" string="Send"
                    class="btn-primary"
                    invisible="is_sent or state in ('done', 'cancel', 'draft')"
                    groups="stock.group_stock_user"/>
            </xpath>
            <xpath expr="//button[@name='button_validate']" position="attributes">
                <attribute name="invisible">state in ('draft', 'cancel', 'sent') or (picking_type_code == 'internal' and not is_sent)</attribute>
            </xpath>
            <!-- Status badge for "Sent" state -->
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="widget">statusbar</attribute>
                <attribute name="statusbar_visible">draft,confirmed,assigned,sent,done</attribute>
            </xpath>
            <!-- Include is_sent as an invisible field so the view knows about it -->
            <xpath expr="//sheet" position="inside">
                <field name="is_sent" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
